BRAIN_API_KEY=
BRAIN_BASE_URL=
BRAIN_MODEL=
MEMORY_MANAGER_API_KEY=
MEMORY_MANAGER_BASE_URL=
MEMORY_MANAGER_MODEL=
# 网络检索 API
WEB_SEARCH_PROVIDER=serper
SERPER_API_KEY=
SERPER_SEARCH_BASE_URL=https://google.serper.dev/search
SERPER_PLACES_BASE_URL=https://google.serper.dev/places
# baidu地图 API，用于国内区域的正逆地理编码及POI检索
BAIDU_MAPS_API_KEY=
# Google 地图 API
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_URL_SIGNING_SECRET=
# MAPILLARY API
MAPILLARY_ACCESS_TOKEN=
MAPILLARY_CLIENT_SECRET=
AUTHENTICATION_URL="https://www.mapillary.com/connect?client_id=25436245865995424"
# LocationIQ API, 用于国外的区域的正逆地理编码，每月150000，每天5000次请求限制
LOCATIONIQ_KEY=
FORWARD_GEOCODING_URL=https://us1.locationiq.com/v1/search
REVERSE_GEOCODING_URL=https://us1.locationiq.com/v1/reverse
# Direct-VLM asynchronous batch evaluation (OpenAI-compatible Files/Batches API)
BATCH_PROVIDER=aliyun
BATCH_API_KEY=
BATCH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BATCH_MODEL=qwen3-vl-plus
BATCH_ENDPOINT=/v1/chat/completions
BATCH_FILES_PATH=/files
BATCH_BATCHES_PATH=/batches
BATCH_AUTH_HEADER=Authorization
BATCH_AUTH_SCHEME=Bearer
BATCH_COMPLETION_WINDOW=24h
BATCH_POLL_INTERVAL_SECONDS=30
BATCH_REQUEST_TIMEOUT_SECONDS=120
BATCH_MAX_REQUESTS_PER_FILE=50000
BATCH_MAX_FILE_MB=500
BATCH_MAX_LINE_MB=1
BATCH_IMAGE_MODE=base64
BATCH_IMAGE_BASE_URL=
BATCH_IMAGE_MAX_EDGE=2048
BATCH_IMAGE_JPEG_QUALITY=90
BATCH_IMAGE_MIN_PIXELS=
BATCH_IMAGE_MAX_PIXELS=
BATCH_MAX_TOKENS=1000
BATCH_TEMPERATURE=0
BATCH_ENABLE_THINKING=
BATCH_THINKING_BUDGET=
BATCH_RESPONSE_FORMAT=
BATCH_REQUEST_EXTRA_JSON={}

LOG_LEVEL=INFO
